# Server logs, secrets and backups must never be downloadable.
<FilesMatch "\.(log|env|sql|rar|zip|bak)$">
    Require all denied
</FilesMatch>

# Keep PHP running after the client disconnects — AI Studio finishes its
# pose/background edit after replying to the poll (LiteSpeed only).
<IfModule Litespeed>
    SetEnv noabort 1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^logs(/|$) - [F,L]
    RewriteRule ^cache(/|$) - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ api.php [L,QSA]
</IfModule>
