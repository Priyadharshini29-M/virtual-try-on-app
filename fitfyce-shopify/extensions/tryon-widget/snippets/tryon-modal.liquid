<div id="tryfit-overlay" class="tryfit-overlay" style="display:none" aria-modal="true" role="dialog" aria-label="Virtual Try-On">
  <div class="tryfit-modal">
    <button class="tryfit-close" id="tryfit-close-btn" aria-label="Close">&times;</button>

    <!-- Step 1: Privacy notice -->
    <div id="tryfit-step-privacy" class="tryfit-step">
      <div class="tryfit-step-inner">
        <h2 class="tryfit-heading">Virtual Try-On</h2>
        <p class="tryfit-privacy-notice">
          Your photo is processed by AI to show how this item looks on you.
          Your photo is <strong>never stored</strong> on our servers after processing.
        </p>
        <button id="tryfit-accept-privacy" class="tryfit-btn tryfit-btn--primary">
          Continue to Upload
        </button>
      </div>
    </div>

    <!-- Step 2: Upload -->
    <div id="tryfit-step-upload" class="tryfit-step" style="display:none">
      <div class="tryfit-step-inner">
        <h2 class="tryfit-heading">Upload Your Photo</h2>

        <div id="tryfit-variant-selector" class="tryfit-variant-selector">
          <!-- Variant selector rendered by JS -->
        </div>

        <label for="tryfit-file-input" class="tryfit-upload-label">
          <span>Select Image</span>
          <input
            type="file"
            id="tryfit-file-input"
            accept="image/*"
            style="display:none"
          >
        </label>

        <p class="tryfit-hint">Supported formats: JPEG, PNG, WebP (Max 5MB)</p>
      </div>
    </div>

    <!-- Step 3: Processing -->
    <div id="tryfit-step-processing" class="tryfit-step" style="display:none">
      <div class="tryfit-step-inner">
        <h2 class="tryfit-heading">Creating your look...</h2>
        <div class="tryfit-progress-bar-wrap">
          <div id="tryfit-progress-bar" class="tryfit-progress-bar" style="width:0%"></div>
        </div>
        <p id="tryfit-progress-msg" class="tryfit-progress-msg">AI is processing your image...</p>
      </div>
    </div>

    <!-- Step 4: Result -->
    <div id="tryfit-step-result" class="tryfit-step" style="display:none">
      <div class="tryfit-step-inner tryfit-result-inner">
        <img
          id="tryfit-result-img"
          class="tryfit-result-img"
          src=""
          alt="Your virtual try-on result"
        >
        <div class="tryfit-cta-row">
          <button id="tryfit-add-cart" class="tryfit-btn tryfit-btn--primary">
            Add to Cart
          </button>
          <button id="tryfit-buy-now" class="tryfit-btn tryfit-btn--secondary">
            Buy Now
          </button>
        </div>
        <div class="tryfit-share-row">
          <button id="tryfit-save-img" class="tryfit-btn tryfit-btn--ghost">
            Save Result
          </button>
          <button id="tryfit-share-wa" class="tryfit-btn tryfit-btn--ghost tryfit-btn--whatsapp">
            Share on WhatsApp
          </button>
        </div>
        <button id="tryfit-retry" class="tryfit-link">
          Change Photo
        </button>
        <p class="tryfit-watermark">Powered by TryFit</p>
      </div>
    </div>

    <!-- Error state -->
    <div id="tryfit-step-error" class="tryfit-step" style="display:none">
      <div class="tryfit-step-inner">
        <p id="tryfit-error-msg" class="tryfit-error-msg"></p>
        <button id="tryfit-retry-error" class="tryfit-btn tryfit-btn--primary">
          Try Again
        </button>
      </div>
    </div>
  </div>
</div>
